    "pcAutomationUF": {
      "rows": [
        [
          {
            "field": "dropdown",
            "key": "source_period_type",
            "label": "Execution Frequency",
            "items": [
              { "value": "", "label": "Select execution frequency" },
              { "value": "month_period", "label": "Monthly" },
              { "value": "week_period", "label": "Weekly" },
              { "value": "day_period", "label": "Daily" }
            ],
            "defaultItemPos": 1,
            "rules": [{ "rule": "required", "message": "Please select an option." }]
          },
          {
            "field": "dropdown",
            "key": "automated",
            "label": "Automation Mode",
            "items": [
              { "value": "", "label": "Select automation mode" },
              { "value": "1", "label": "Automated" },
              { "value": "0", "label": "Manual" }
            ],
            "defaultItemPos": 1,
            "rules": [{ "rule": "required", "message": "Please select an option." }]
          }
        ],
        [
          {
            "field": "label",
            "text": "Paste or enter the Rule Configuration as json or csv:"
          }
        ],
        [
          {
            "field": "text",
            "key": "rule_config_json",
            "label": "Rule Configuration (csv or json)",
            "hint": "Pipeline-specific Rule Configuration",
            "defaultValue": "[]",
            "maxLines": 13,
            "maxLength": 51200,
            "rules": [{ "rule": "required", "message": "Please provide a value." }]
          }
        ],
        [{ "field": "spacer" }]
      ],
      "actions": [
        { "action": "ufPrevious", "label": "Previous", "style": "primary" },
        { "action": "ufCancel", "label": "Cancel", "style": "primary" },
        { "action": "ufNext", "label": "Next", "style": "secondary" }
      ]
    },
