{
  "schemaVersion": 1,
  "forms": {
    "pcAddOrEditPipelineConfigUF": {
      "rows": [
        [{ "field": "spacer" }],
        [
          {
            "field": "dataTable",
            "key": "pcAddOrEditPipelineConfigOption",
            "table": "pcAddOrEditPipelineConfigOption",
            "rules": [{ "rule": "required", "message": "Please select an option." }]
          }
        ]
      ],
      "actions": [
        { "action": "ufPrevious", "label": "Previous", "style": "primary" },
        { "action": "ufCancel", "label": "Cancel", "style": "primary" },
        { "action": "ufNext", "label": "Next", "style": "secondary" }
      ]
    },
    "pcAddPipelineConfigUF": {
      "queries": {
        "clients": {
          "sql": "SELECT client FROM jetsapi.client_registry ORDER BY client ASC LIMIT 150"
        },
        "processes": {
          "sql": "SELECT process_name, key FROM jetsapi.process_config ORDER BY process_name ASC LIMIT 100"
        }
      },
      "rows": [
        [{ "field": "spacer" }],
        [
          {
            "field": "dropdown",
            "key": "client",
            "label": "Client",
            "items": [{ "value": "", "label": "Select a Client" }],
            "itemsFrom": "clients",
            "rules": [{ "rule": "required", "message": "Please select an option." }]
          }
        ],
        [{ "field": "spacer" }],
        [
          {
            "field": "dropdown",
            "key": "process_name",
            "label": "Process",
            "items": [{ "value": "", "label": "Select a process" }],
            "itemsFrom": "processes",
            "rules": [{ "rule": "required", "message": "Please select an option." }]
          }
        ],
        [{ "field": "spacer" }],
        [
          {
            "field": "text",
            "key": "description",
            "label": "Description",
            "hint": "Pipeline configuration description",
            "maxLength": 512
          }
        ],
        [{ "field": "spacer" }]
      ],
      "actions": [
        { "action": "ufPrevious", "label": "Previous", "style": "primary" },
        { "action": "ufCancel", "label": "Cancel", "style": "primary" },
        { "action": "ufNext", "label": "Next", "style": "secondary" }
      ]
    },
