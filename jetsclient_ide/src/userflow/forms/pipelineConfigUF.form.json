            "isReadOnly": true,
            "rules": [{ "rule": "required", "message": "Please select an option." }]
          },
          {
            "field": "dropdown",
            "key": "automated",
            "label": "Automation Mode",
            "items": [
              { "value": "", "label": "Select automation mode" },
              { "value": "1", "label": "Automated" },
              { "value": "0", "label": "Manual" }
            ],
            "isReadOnly": true,
            "rules": [{ "rule": "required", "message": "Please select an option." }]
          }
        ],
        [
          {
            "field": "text",
            "key": "description",
            "label": "Description",
            "hint": "Pipeline configuration description",
            "maxLength": 512
          }
        ],
        [{ "field": "spacer" }],
        [
          {
            "field": "dataTable",
            "key": "pcSummaryProcessInputs",
            "table": "pcSummaryProcessInputs"
          }
        ],
        [
          {
            "field": "text",
            "key": "rule_config_json",
            "label": "Rule Configuration CSV / Json",
            "hint": "Enter a valid json array or csv with headers of configuration objects",
            "isReadOnly": true,
            "defaultValue": "[]",
            "maxLength": 51200,
            "rules": [{ "rule": "required", "message": "Please provide a value." }]
          }
        ]
