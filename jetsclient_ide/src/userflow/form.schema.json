{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "forms": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.-]+$",
        "description": "A key naming a state, form, action or form-state entry"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Form"
      }
    }
  },
  "required": [
    "schemaVersion",
    "forms"
  ],
  "additionalProperties": false,
  "title": "JetStore UserFlow form document",
  "description": "The forms of one user flow, authored as data",
  "$defs": {
    "Form": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "queries": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "description": "A key naming a state, form, action or form-state entry"
          },
          "additionalProperties": {
            "$ref": "#/$defs/FormQuery"
          }
        },
        "rows": {
          "minItems": 1,
          "type": "array",
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/Field"
            }
          }
        },
        "actions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormAction"
          }
        }
      },
      "required": [
        "rows",
        "actions"
      ],
      "additionalProperties": false,
      "description": "One screen of a user flow"
    },
    "FormQuery": {
      "type": "object",
      "properties": {
        "sql": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "description": "A key naming a state, form, action or form-state entry"
          }
        }
      },
      "required": [
        "sql"
      ],
      "additionalProperties": false,
      "description": "A named query filling a form's item sources"
    },
    "Field": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "text"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a state, form, action or form-state entry"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "hint": {
              "type": "string"
            },
            "maxLines": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxLength": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "autofocus": {
              "type": "boolean"
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Rule"
              }
            }
          },
          "required": [
            "field",
            "key",
            "label"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "dataTable"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a state, form, action or form-state entry"
            },
            "table": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a state, form, action or form-state entry"
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Rule"
              }
            }
          },
          "required": [
            "field",
            "key",
            "table"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "dropdown"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a state, form, action or form-state entry"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "items": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/DropdownItem"
              }
            },
            "itemsFrom": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a state, form, action or form-state entry"
            },
            "defaultItemPos": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "isReadOnly": {
              "type": "boolean"
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Rule"
              }
            }
          },
          "required": [
            "field",
            "key",
            "label",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "typeahead"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a state, form, action or form-state entry"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "hint": {
              "type": "string"
            },
            "itemsFrom": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a state, form, action or form-state entry"
            },
            "priorityKey": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a state, form, action or form-state entry"
            },
            "maxLength": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Rule"
              }
            }
          },
          "required": [
            "field",
            "key",
            "label",
            "itemsFrom"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "label"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "field",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "spacer"
            }
          },
          "required": [
            "field"
          ],
          "additionalProperties": false
        }
      ],
      "description": "One field of a form"
    },
    "Rule": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "rule": {
              "type": "string",
              "const": "required"
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "rule",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "rule": {
              "type": "string",
              "const": "json"
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "rule",
            "message"
          ],
          "additionalProperties": false
        }
      ],
      "description": "A field-level validation rule"
    },
    "DropdownItem": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false,
      "description": "One choice offered by a dropdown"
    },
    "FormAction": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "description": "A key naming a state, form, action or form-state entry"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "danger"
          ]
        },
        "capability": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "description": "A key naming a state, form, action or form-state entry"
        },
        "enableOnlyWhenFormValid": {
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "label"
      ],
      "additionalProperties": false
    }
  }
}
