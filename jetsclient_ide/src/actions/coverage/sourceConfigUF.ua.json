{
  "schemaVersion": 1,
  "actions": {
    "scStartUF": {
      "description": "Start the file configuration flow",
      "steps": [{ "do": "notify", "level": "info", "message": "Configure a file data source" }]
    },
    "scEditXlsxOptionsUF": {
      "description": "Record the chosen spreadsheet sheet",
      "steps": [
        { "do": "set", "key": "input_format_data_json", "value": { "template": "{\"currentSheet\": \"{currentSheet}\"}" } }
      ]
    },
    "scSelectSourceConfigUF": {
      "description": "Load the selected file configuration, inferring the file type for older records",
      "steps": [{ "do": "escape", "name": "loadSourceConfigWithFileTypeInference" }]
    },
    "scAddSourceConfigUF": {
      "description": "Derive the staging table name from client, org and object type",
      "steps": [
        { "do": "set", "key": "table_name", "value": { "template": "{client}_{org}_{object_type}" } }
      ]
    },
    "addSourceConfig.ok": {
      "description": "Save the file configuration, nulling the fields its file type does not use",
      "steps": [
        { "do": "validate" },
        { "do": "escape", "name": "saveSourceConfigForFileType" }
      ]
    },
    "deleteSourceConfig": {
      "description": "Delete the selected file configuration",
      "steps": [
        { "do": "confirm", "message": "Are you sure you want to delete the selected File Configuration?" },
        { "do": "set", "key": "key", "value": { "fromKey": "key" } },
        { "do": "clearSelection", "key": "scSourceConfigKey" },
        { "do": "post", "endpoint": "/dataTable", "action": "insert_rows", "table": "delete/source_config",
          "data": { "rows": "wholeState" } },
        { "do": "remove", "keys": ["scSourceConfigKey", "key", "client", "org", "object_type", "input_format"] }
      ]
    },
    "dropTable": {
      "description": "Drop the staging table of the selected data source",
      "steps": [
        { "do": "post", "endpoint": "/dataTable", "action": "drop_table",
          "data": {
            "rows": "fields",
            "fields": { "schemaName": { "literal": "public" }, "tableName": { "fromKey": "table_name" } }
          } }
      ]
    },
    "dialogCancel": {
      "description": "Dismiss the dialog",
      "steps": [{ "do": "close" }]
    }
  }
}
