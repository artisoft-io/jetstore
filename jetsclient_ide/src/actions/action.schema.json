{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "formStateInitializer": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "description": "A key naming a form-state entry, action, state or table"
    },
    "actions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.-]+$",
        "description": "A key naming a form-state entry, action, state or table"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Action"
      }
    }
  },
  "required": [
    "schemaVersion",
    "actions"
  ],
  "additionalProperties": false,
  "title": "JetStore UserFlow action document",
  "description": "The named actions of one user flow, authored as data",
  "$defs": {
    "Action": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        }
      },
      "required": [
        "description",
        "steps"
      ],
      "additionalProperties": false,
      "description": "A named action: a description and its steps"
    },
    "Step": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "do": {
              "type": "string",
              "const": "validate"
            }
          },
          "required": [
            "do"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "type": "string",
              "const": "confirm"
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "do",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "type": "string",
              "const": "set"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a form-state entry, action, state or table"
            },
            "value": {
              "$ref": "#/$defs/Value"
            }
          },
          "required": [
            "do",
            "key",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "type": "string",
              "const": "remove"
            },
            "keys": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.-]+$",
                "description": "A key naming a form-state entry, action, state or table"
              }
            }
          },
          "required": [
            "do",
            "keys"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "type": "string",
              "const": "clearSelection"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a form-state entry, action, state or table"
            }
          },
          "required": [
            "do",
            "key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "type": "string",
              "const": "appendUnique"
            },
            "listKey": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a form-state entry, action, state or table"
            },
            "value": {
              "$ref": "#/$defs/Value"
            }
          },
          "required": [
            "do",
            "listKey",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "type": "string",
              "const": "removeFrom"
            },
            "listKey": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a form-state entry, action, state or table"
            },
            "value": {
              "$ref": "#/$defs/Value"
            }
          },
          "required": [
            "do",
            "listKey",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "type": "string",
              "const": "post"
            },
            "endpoint": {
              "$ref": "#/$defs/Endpoint"
            },
            "action": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a form-state entry, action, state or table"
            },
            "table": {
              "type": "string",
              "minLength": 1
            },
            "extras": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.-]+$",
                "description": "A key naming a form-state entry, action, state or table"
              },
              "additionalProperties": {
                "$ref": "#/$defs/Value"
              }
            },
            "transport": {
              "type": "string",
              "enum": [
                "simple",
                "insertRows"
              ]
            },
            "spinner": {
              "type": "boolean"
            },
            "onConflict": {
              "type": "string",
              "minLength": 1
            },
            "data": {
              "$ref": "#/$defs/Rows"
            }
          },
          "required": [
            "do",
            "endpoint",
            "action",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "type": "string",
              "const": "query"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a form-state entry, action, state or table"
            },
            "into": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.-]+$",
                "description": "A key naming a form-state entry, action, state or table"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.-]+$",
                "description": "A key naming a form-state entry, action, state or table"
              }
            }
          },
          "required": [
            "do",
            "name",
            "into"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "type": "string",
              "const": "goToState"
            },
            "state": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a form-state entry, action, state or table"
            }
          },
          "required": [
            "do",
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "type": "string",
              "const": "close"
            }
          },
          "required": [
            "do"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "type": "string",
              "const": "notify"
            },
            "level": {
              "type": "string",
              "enum": [
                "info",
                "error"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "do",
            "level",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "type": "string",
              "const": "fail"
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "do",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "type": "string",
              "const": "escape"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a form-state entry, action, state or table"
            }
          },
          "required": [
            "do",
            "name"
          ],
          "additionalProperties": false
        }
      ],
      "description": "One step of an action"
    },
    "Value": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "literal": {
              "type": "string"
            }
          },
          "required": [
            "literal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "fromKey": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a form-state entry, action, state or table"
            }
          },
          "required": [
            "fromKey"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "fromKeyList": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a form-state entry, action, state or table"
            }
          },
          "required": [
            "fromKeyList"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "pgArrayFromKey": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a form-state entry, action, state or table"
            }
          },
          "required": [
            "pgArrayFromKey"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "fromKeyAtIndex": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a form-state entry, action, state or table"
            }
          },
          "required": [
            "fromKeyAtIndex"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "template": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "template"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "userEmail": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "userEmail"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "nowMillis": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "nowMillis"
          ],
          "additionalProperties": false
        }
      ],
      "description": "A value read from form state, the session, or a literal"
    },
    "Endpoint": {
      "type": "string",
      "enum": [
        "/dataTable",
        "/registerFileKey",
        "/purgeData",
        "/inferServer"
      ]
    },
    "Rows": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "rows": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "rows"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "rows": {
              "type": "string",
              "const": "fields"
            },
            "fields": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.-]+$",
                "description": "A key naming a form-state entry, action, state or table"
              },
              "additionalProperties": {
                "$ref": "#/$defs/Value"
              }
            }
          },
          "required": [
            "rows",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "rows": {
              "type": "string",
              "const": "wholeState"
            },
            "normalise": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_.-]+$",
                    "description": "A key naming a form-state entry, action, state or table"
                  },
                  "as": {
                    "$ref": "#/$defs/Value"
                  }
                },
                "required": [
                  "key",
                  "as"
                ],
                "additionalProperties": false
              }
            },
            "omit": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.-]+$",
                "description": "A key naming a form-state entry, action, state or table"
              }
            }
          },
          "required": [
            "rows"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "rows": {
              "type": "string",
              "const": "fanOut"
            },
            "over": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "A key naming a form-state entry, action, state or table"
            },
            "fields": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.-]+$",
                "description": "A key naming a form-state entry, action, state or table"
              },
              "additionalProperties": {
                "$ref": "#/$defs/Value"
              }
            }
          },
          "required": [
            "rows",
            "over",
            "fields"
          ],
          "additionalProperties": false
        }
      ],
      "description": "How the request's data array is built"
    }
  }
}
