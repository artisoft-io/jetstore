{
  "comment": "The Workspace IDE's toolbar: workspaceRegistryTable actions that need a workspace, moved off the registry on 2026-10-11 so they act on the workspace the IDE has open. Each runs against that workspace's registry row, so navigationParams indices and enableWhen columns mean what they mean on workspaceRegistryTable.tc.json. Rows, top to bottom.",
  "rows": [
    [
      {
        "key": "exportWorkspaceClientConfig",
        "label": "Export Client Config",
        "action": "showDialog",
        "style": "secondary",
        "configForm": "exportWorkspaceClientConfig",
        "isVisibleWhenCheckboxVisible": true,
        "isEnabledWhenHavingSelectedRows": true,
        "navigationParams": {
          "key": 0,
          "workspace_name": 1,
          "workspace_branch": 2,
          "feature_branch": 3,
          "workspace_uri": 4
        },
        "enableWhen": [
          [
            {
              "column": "status",
              "is": "doesNotContain",
              "value": "removed"
            },
            {
              "column": "status",
              "is": "doesNotContain",
              "value": "in progress"
            }
          ]
        ]
      },
      {
        "key": "loadWorkspaceConfig",
        "label": "Load Client Config",
        "action": "showScreen",
        "style": "secondary",
        "configScreenPath": "/workspaces/loadConfigUF/:workspace_name",
        "isVisibleWhenCheckboxVisible": true,
        "isEnabledWhenHavingSelectedRows": true,
        "navigationParams": {
          "workspace_name": 1
        },
        "enableWhen": [
          [
            {
              "column": "status",
              "is": "doesNotContain",
              "value": "in progress"
            }
          ]
        ]
      }
    ],
