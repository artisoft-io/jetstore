{
  "schemaVersion": 1,
  "forms": {
    "showFailureDetailsDialog": {
      "title": "Pipeline Failure Details",
      "rows": [
        [
          {
            "field": "text",
            "key": "failure_details",
            "label": "Failure Details",
            "hint": "This is read only",
            "maxLines": 20,
            "maxLength": 4000000
          }
        ]
      ],
      "actions": [
        {
          "action": "dialogCancel",
          "label": "Close",
          "style": "primary"
        }
      ]
    },
    "putSchemaEventDialog": {
      "title": "Put Schema Event",
      "rows": [
        [
          {
            "field": "label",
            "text": "Paste or enter the schema event as json. It is saved under a unique name in the schema triggers folder, which registers it."
          }
        ],
        [
          {
            "field": "text",
            "key": "schemaEventJson",
            "label": "Schema Event (json)",
            "hint": "Schema event json defines the file schema and the source file location to use as file key",
            "maxLines": 13,
            "maxLength": 51200,
            "autofocus": true,
            "rules": [
              { "rule": "required", "message": "Please provide a Schema Event json" },
              { "rule": "json", "message": "Schema Event is not a valid json" }
            ]
          }
        ]
      ],
      "actions": [
        {
          "action": "putSchemaEvent",
          "label": "Save",
          "style": "primary",
          "capability": "run_pipelines"
        },
        { "action": "dialogCancel", "label": "Cancel", "style": "secondary" }
      ]
    },
    "sessionRegistryFiltersDialog": {
      "title": "Session Registry Filters",
      "validator": "sessionRegistryFiltersValidator",
      "rows": [
        [
          {
            "field": "label",
            "text": "Leave a field blank for no filter. Saving replaces the tab's filters, a session id filter included."
          }
        ],
        [
          {
            "field": "text",
            "key": "srSourceType",
            "label": "Source Type",
            "hint": "file or domain_table",
            "autofocus": true,
            "maxLength": 40
          }
        ],
        [
          {
            "field": "text",
            "key": "srMonthPeriodFrom",
            "label": "From Month Period",
            "hint": "As in the Month Period column",
            "maxLength": 9,
            "textRestriction": "digitsOnly"
          },
          {
            "field": "text",
            "key": "srMonthPeriodTo",
            "label": "To Month Period",
            "hint": "As in the Month Period column",
            "maxLength": 9,
            "textRestriction": "digitsOnly"
          }
        ],
        [
          {
            "field": "text",
            "key": "srUpdatedFrom",
            "label": "Registered After",
            "hint": "A date (2026-11-08), a date and time (2026-11-08T15:00:00Z), or a duration ago (3 days)",
            "maxLength": 25
          },
          {
            "field": "text",
            "key": "srUpdatedTo",
            "label": "Registered Before",
            "hint": "A date (2026-11-08), a date and time (2026-11-08T15:00:00Z), or a duration ago (3 days)",
            "maxLength": 25
          }
        ]
      ],
      "actions": [
        { "action": "setSessionRegistryFilters", "label": "Save", "style": "primary" },
        { "action": "dialogCancel", "label": "Cancel", "style": "secondary" }
      ]
    }
  }
}
