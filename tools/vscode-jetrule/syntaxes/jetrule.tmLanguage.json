{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "JetRule",
  "scopeName": "source.jetrule",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#rule-header" },
    { "include": "#compiler-directive" },
    { "include": "#storage-declarators" },
    { "include": "#statement-keywords" },
    { "include": "#config-properties" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#rule-variables" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#namespaced-identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.jetrule",
          "begin": "#",
          "end": "$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.jetrule",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.jetrule",
          "match": "\\\\(\"|\\\\)"
        }
      ]
    },
    "compiler-directive": {
      "name": "keyword.other.directive.jetrule",
      "match": "@JetCompilerDirective\\b"
    },
    "rule-header": {
      "begin": "(\\[)\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.rule.begin.jetrule" },
        "2": { "name": "entity.name.function.rule.jetrule" }
      },
      "end": "(\\])",
      "endCaptures": {
        "1": { "name": "punctuation.definition.rule.end.jetrule" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#constants" },
        { "include": "#numbers" },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
          "captures": {
            "1": { "name": "variable.parameter.rule-property.jetrule" },
            "2": { "name": "keyword.operator.assignment.jetrule" }
          }
        }
      ]
    },
    "storage-declarators": {
      "name": "storage.modifier.jetrule",
      "match": "\\b(resource|volatile_resource)\\b"
    },
    "statement-keywords": {
      "name": "keyword.control.jetrule",
      "match": "\\b(class|lookup_table|triple|rule_sequence|main|jetstore_config)\\b"
    },
    "config-properties": {
      "name": "support.type.property-name.jetrule",
      "match": "\\$(base_classes|data_properties|object_properties|grouping_properties|as_table|max_looping|max_rule_exec|input_types|main_rule_sets|table_name|csv_file|key|columns)\\b"
    },
    "types": {
      "patterns": [
        {
          "name": "keyword.other.array.jetrule",
          "match": "\\barray of\\b"
        },
        {
          "name": "storage.type.jetrule",
          "match": "\\b(int|uint|long|ulong|double|text|date|datetime|bool)\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language.jetrule",
      "match": "\\b(true|false|null)\\b"
    },
    "functions": {
      "name": "support.function.jetrule",
      "match": "\\b(create_uuid_resource|create_entity|toText)\\b"
    },
    "rule-variables": {
      "name": "variable.parameter.jetrule",
      "match": "\\?[A-Za-z_][A-Za-z0-9_]*"
    },
    "numbers": {
      "name": "constant.numeric.jetrule",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.jetrule",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.regex.jetrule",
          "match": "r\\?"
        },
        {
          "name": "keyword.operator.logical.jetrule",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.jetrule",
          "match": "(\\+|-|\\*|/)"
        },
        {
          "name": "keyword.operator.implication.jetrule",
          "match": "->"
        },
        {
          "name": "keyword.operator.assignment.jetrule",
          "match": "="
        }
      ]
    },
    "namespaced-identifiers": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "entity.name.namespace.jetrule" },
        "2": { "name": "punctuation.separator.namespace.jetrule" },
        "3": { "name": "entity.name.type.jetrule" }
      }
    }
  }
}
