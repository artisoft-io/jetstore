                      "op": "==",
                      "lhs": {
                        "type": "select",
                        "expr": "program_start_date"
                      },
                      "rhs": {
                        "type": "select",
                        "expr": "program_end_date"
                      }
                    },
                    "rhs": {
                      "op": "AND",
                      "lhs": {
                        "op": "NOT",
                        "arg": {
                          "op": "IS",
                          "lhs": {
                            "type": "select",
                            "expr": "program_start_date"
                          },
