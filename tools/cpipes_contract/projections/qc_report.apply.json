                        "type": "value",
                        "expr": "0"
                      }
                    }
                  }
                },
                {
                  "name": "$cpipesBinding:bindings.metrics.7.name",
                  "type": "count",
                  "expr": "*",
                  "where": {
                    "lhs": {
                      "lhs": {
                        "type": "select",
                        "expr": "program_end_date",
                        "as_rdf_type": "date"
                      },
                      "op": "-",
                      "rhs": {
                        "type": "select",
                        "expr": "program_start_date",
                        "as_rdf_type": "date"
                      }
                    },
                    "op": "==",
                    "rhs": {
                      "type": "select",
                      "expr": "mbr_days_in_program",
                      "as_rdf_type": "int"
                    }
                  }
                }
              ],
              "output_channel": {
                "name": "$cpipesBinding:bindings._item.metrics_mapped",
                "channel_spec_name": "$cpipesBinding:bindings._item.metrics_channel"
