                          }
                        }
                      },
                      "rhs": {
                        "op": "NOT",
                        "arg": {
                          "op": "IS",
                          "lhs": {
                            "type": "select",
                            "expr": "program_end_date"
                          },
                          "rhs": {
                            "type": "value",
                            "expr": "NULL"
