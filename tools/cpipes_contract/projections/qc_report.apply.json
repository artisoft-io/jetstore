                          "as_rdf_type": "date"
                        },
                        "op": "==",
                        "rhs": {
                          "type": "value",
                          "expr": "'2099-12-31'",
                          "as_rdf_type": "date"
                        }
                      }
                    }
                  }
                },
                {
                  "name": "$cpipesBinding:bindings.metrics.5.name",
                  "type": "count",
