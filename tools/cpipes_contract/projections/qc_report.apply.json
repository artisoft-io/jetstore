{
  "schemaVersion": 1,
  "template": "qc_report",
  "fillMarker": "$cpipesFill",
  "bindingMarker": "$cpipesBinding:",
  "choosers": {},
  "constants": {},
  "jsonFields": [
    "bindings._item.data_columns",
    "bindings._item.metric_columns"
  ],
  "skeleton": {
    "cluster_config": {
      "default_max_concurrency": 40,
      "s3_worker_pool_size": 40,
      "default_shard_size_mb": 20,
      "default_shard_max_size_mb": 28
    },
    "context": [
      {
        "type": "file_key_component",
        "key": "$PROCESSING_TICKET",
        "expr": "processing_ticket"
      },
      {
        "type": "value",
        "key": "$REPORT",
        "expr": "$cpipesBinding:bindings._item.report"
      },
      {
        "type": "value",
        "key": "$CGT_FILE_TYPE",
        "expr": "$cpipesBinding:bindings._item.file_type"
      },
      {
        "type": "value",
        "key": "$CGT_NOTIFICATION_TYPE",
        "expr": "Test Harness"
      },
      {
        "type": "partfile_key_component",
        "key": "layout_name",
        "expr": "layout"
      }
    ],
    "output_files": [
      {
        "key": "report_output",
        "name": "$REPORT_$SESSIONID_report.csv",
        "headers": [
          "test_id",
          "test_name",
          "numerator_value",
          "denominator_value",
          "ratio",
          "test_result",
          "layout_name",
          "rawfilename",
          "processing_ticket",
          "session_id"
        ]
      }
    ],
    "lookup_tables": [
      {
        "key": "thresholds",
        "type": "sql_lookup",
        "query": "WITH qc1 AS (SELECT field_id, upper_failure, upper_warning, lower_failure, lower_warning FROM PUBLIC.qc_client_thresholds WHERE client = SUBSTRING('$PROCESSING_TICKET', 1, 7) AND layout_name = '$JETS_PARTITION_LABEL' AND report = '$REPORT'), qc2 AS (SELECT field_id, upper_failure, upper_warning, lower_failure, lower_warning FROM PUBLIC.qc_client_thresholds WHERE client = SUBSTRING('$PROCESSING_TICKET', 1, 7) AND layout_name = '' AND report = '$REPORT' AND field_id NOT IN (SELECT field_id FROM qc1)) SELECT * FROM qc1 UNION SELECT * FROM qc2 UNION (SELECT field_id, upper_failure, upper_warning, lower_failure, lower_warning FROM PUBLIC.qc_thresholds WHERE report = '$REPORT' AND field_id NOT IN (SELECT field_id FROM qc1 UNION SELECT field_id FROM qc2))",
        "columns": [
          {
            "name": "field_id",
            "rdf_type": "text"
          },
          {
            "name": "upper_failure",
            "rdf_type": "double"
          },
          {
            "name": "upper_warning",
            "rdf_type": "double"
          },
          {
            "name": "lower_failure",
            "rdf_type": "double"
          },
          {
            "name": "lower_warning",
            "rdf_type": "double"
          }
        ],
        "lookup_key": [
          "field_id"
        ],
        "lookup_values": [
          "upper_failure",
          "upper_warning",
          "lower_failure",
          "lower_warning"
        ]
      }
    ],
    "channels": [
      {
        "name": "$cpipesBinding:bindings._item.data_channel",
        "columns": "$cpipesBinding:bindings._item.data_columns"
      },
      {
        "name": "$cpipesBinding:bindings._item.metrics_channel",
        "columns": "$cpipesBinding:bindings._item.metric_columns"
      },
      {
        "name": "qc_metrics",
        "columns": [
          "dw_rawfilename",
          "layout_name",
          "field",
          "field_id",
          "numerator",
          "denominator",
          "ratio",
          "upper_failure",
          "upper_warning",
          "lower_failure",
          "lower_warning"
        ]
      },
      {
        "name": "report_output",
        "columns": [
          "field_id",
          "field",
          "numerator",
          "denominator",
          "ratio",
          "status",
          "layout_name",
          "dw_rawfilename",
          "processing_ticket",
          "session_id"
        ]
      }
    ],
    "reducing_pipes_config": [
      [
        {
          "type": "fan_out",
          "input_channel": {
            "type": "input",
            "name": "input_row"
          },
          "apply": [
            {
              "type": "map_record",
              "new_record": true,
              "columns": [
                {
                  "name": "dw_rawfilename",
                  "type": "map",
                  "expr": "dw_rawfilename",
                  "map_expr": {
                    "default": "dw_rawfilename",
                    "rdf_type": "text"
                  }
                },
                {
                  "name": "layout_name",
                  "type": "select",
                  "expr": "layout_name"
                },
                {
                  "name": "jets_partition",
                  "type": "hash",
                  "hash_expr": {
                    "composite_expr": [
                      "mbr_first_name",
                      "mbr_last_name",
                      "format_date(mbr_dob)"
                    ]
                  }
                },
                {
                  "name": "mbr_first_name",
                  "type": "select",
                  "expr": "mbr_first_name"
                },
                {
                  "name": "mbr_last_name",
                  "type": "select",
                  "expr": "mbr_last_name"
                },
                {
                  "name": "mbr_dob",
                  "type": "select",
                  "expr": "mbr_dob"
                },
                {
                  "name": "program_start_date",
                  "type": "map",
                  "expr": "program_start_date",
                  "map_expr": {
                    "rdf_type": "date"
                  }
                },
                {
                  "name": "program_end_date",
                  "type": "map",
                  "expr": "program_end_date",
                  "map_expr": {
                    "rdf_type": "date"
                  }
                },
                {
                  "name": "mbr_days_in_program",
                  "type": "select",
                  "expr": "mbr_days_in_program"
                }
              ],
              "output_channel": {
                "name": "$cpipesBinding:bindings._item.data_writer",
                "channel_spec_name": "$cpipesBinding:bindings._item.data_channel"
              }
            }
          ]
        },
        {
          "type": "splitter",
          "input_channel": {
            "name": "$cpipesBinding:bindings._item.data_writer"
          },
          "splitter_config": {
            "column": "jets_partition"
          },
          "apply": [
            {
              "type": "partition_writer",
              "partition_writer_config": {
                "partition_size": 200000,
                "device_writer_type": "csv_writer"
              },
              "output_channel": {
                "type": "stage",
                "name": "$cpipesBinding:bindings._item.data_out",
                "write_step_id": "reducing01",
                "channel_spec_name": "$cpipesBinding:bindings._item.data_channel"
              }
            }
          ]
        }
      ],
      [
        {
          "type": "splitter",
          "input_channel": {
            "type": "stage",
            "name": "participation_data",
            "read_step_id": "reducing01"
          },
          "splitter_config": {
            "column": "dw_rawfilename"
          },
          "apply": [
            {
              "type": "aggregate",
              "new_record": true,
              "columns": [
                {
                  "name": "dw_rawfilename",
                  "type": "select",
                  "expr": "dw_rawfilename"
                },
                {
                  "name": "layout_name",
                  "type": "select",
                  "expr": "layout_name"
                },
                {
                  "name": "n",
                  "type": "count",
                  "expr": "*"
                },
                {
                  "name": "$cpipesBinding:bindings.distinct_metrics.0.name",
                  "type": "distinct_count",
                  "expr": "$cpipesBinding:bindings.distinct_metrics.0.expr"
                },
                {
                  "name": "$cpipesBinding:bindings.metrics.0.name",
                  "type": "count",
                  "expr": "*",
                  "where": {
                    "lhs": {
                      "type": "select",
                      "expr": "mbr_first_name"
                    },
                    "op": "IS",
