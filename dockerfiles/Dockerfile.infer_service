FROM cpipes_builder:latest AS builder

# Ollama + cbooter, run as an EC2-backed ECS task on a GPU instance.
# The NVIDIA driver comes from the host through the ECS nvidia runtime (the task
# definition asks for a GPU via GpuCount); the CUDA runtime libraries this binary
# needs ship inside the Ollama archive under /usr/local/lib/ollama.
FROM public.ecr.aws/amazonlinux/amazonlinux:2023

# shadow-utils provides groupadd/useradd; tar and zstd unpack the Ollama archive.
RUN dnf update -y && \
  dnf install -y shadow-utils tar zstd && \
  dnf clean all

# Create a system group and user -- the uid/gid must match the ones cbooter drops
# privileges to. Amazon Linux 2023 does not predefine 999 (its highest system uid
# is 14), so this has to be created explicitly.
ARG USER_ID="999"
ARG GROUP_ID="999"
RUN groupadd -g ${GROUP_ID} jsuser \
    && useradd -l -r -u ${USER_ID} -g jsuser jsuser

# Install Ollama from the official release archive, unpacked into /usr/local so it
# lands as /usr/local/bin/ollama plus /usr/local/lib/ollama.
#
# The version is pinned deliberately: the release layout changed from .tgz to
# .tar.zst at v0.32 (the documented https://ollama.com/download/...tgz URL now 404s),
# and the archive is ~1.4 GB, so an unpinned "latest" is neither reproducible nor cheap.
ARG OLLAMA_VERSION=v0.32.5
RUN curl -fsSL "https://github.com/ollama/ollama/releases/download/${OLLAMA_VERSION}/ollama-linux-amd64.tar.zst" \
      | zstd -d | tar -xf - -C /usr/local \
    && test -x /usr/local/bin/ollama \
    && test -d /usr/local/lib/ollama

ENV JETS_SOURCE_DIR=/app JETS_BUILD_DIR=/app

ARG JETS_VERSION
ENV JETS_VERSION=${JETS_VERSION}
ARG JETS_GIT_SHA
ENV JETS_GIT_SHA=${JETS_GIT_SHA}
ARG OLLAMA_VERSION
RUN echo "----------------JetStore-Version------------------" >> /VERSION.txt && \
    echo "JETS_VERSION: ${JETS_VERSION}"                      >> /VERSION.txt && \
    echo "JETS_GIT_SHA: ${JETS_GIT_SHA}"                      >> /VERSION.txt && \
    echo "OLLAMA_VERSION: ${OLLAMA_VERSION}"                  >> /VERSION.txt && \
    echo "----------------*********************-------------" >> /VERSION.txt

# cbooter is the entrypoint: it runs as root, prepares the mounted volume, then
# starts ollama as jsuser.
COPY --from=builder $JETS_SOURCE_DIR/cbooter /usr/local/bin/
RUN chmod +x /usr/local/bin/cbooter

# Defaults for a local `docker run`; the CDK stack sets these explicitly on the
# container definition. OLLAMA_MODELS puts the weights on the mounted volume --
# jsuser has no writable home, so Ollama's default of $HOME/.ollama will not do.
ENV JETS_TEMP_DATA=/jetsdata
ENV TMPDIR=${JETS_TEMP_DATA}/tmp
ENV OLLAMA_MODELS=${JETS_TEMP_DATA}/ollama
ENV OLLAMA_HOST=0.0.0.0:11434
# Dropping to uid 999 does not change HOME. Left at the inherited /root, Ollama fails to
# write its signing key and caches under /root/.ollama; point it at the mounted volume.
ENV HOME=${JETS_TEMP_DATA}/home

EXPOSE 11434

WORKDIR ${JETS_TEMP_DATA}

# CMD must be cleared, not just left unset: the amazonlinux base image sets
# CMD ["/bin/bash"], and ECS overriding only entryPoint would leave that in place
# and append "/bin/bash" to cbooter's arguments.
ENTRYPOINT ["cbooter", "infer_server"]
CMD []
