# Multi-stage build for Go Lambda with C++ library
FROM cpipes_builder:latest AS builder

# RUN \
#     echo "/usr/local/lib64/ DIRECTORY Contains" \
#     && ls -la /usr/local/lib64/

# Use the Amazon Linux 2023 Lambda base image
FROM public.ecr.aws/lambda/provided:al2023

# # Install runtime dependencies
# # Installs headers and compiled libraries for C++ standard library and Boost
RUN dnf update -y && \
  dnf install -y libstdc++ && \
  dnf clean all

ENV JETS_SOURCE_DIR=/app JETS_BUILD_DIR=/app

# Provenance only, and the omission below is deliberate.
#
# build_cpipes.sh passes both of these and this stage discarded them, because an
# ARG is scoped to its stage and ENV does not cross the FROM above. Declaring the
# ARGs consumes them and records them in /VERSION.txt, so the image can be
# identified the way cpipes and ui_service can.
#
# JETS_VERSION is NOT promoted to ENV here, which its siblings do.  Doing that is
# what lets SyncComputePipesWorkspace skip fetching workspace.tgz and sqlite when
# the database's workspace version matches the image's - and in this image alone
# that skip would be a defect rather than a saving:
#
#   - cpipes (the ECS task) is started by `cbooter cpipes_native_server`, and
#     cbooter copies WORKSPACES_REPO to WORKSPACES_HOME before the process runs
#     (jets/cmds/cbooter/main.go:180). The baked workspace is therefore already
#     at the path the code reads, and skipping the fetch is correct.
#   - this image has no cbooter. Its entrypoint is the Lambda runtime interface
#     and CMD is the handler, so nothing copies /workspaces anywhere; the CDK
#     gives it WORKSPACES_HOME=/tmp/workspaces, which starts empty on every cold
#     start. Skip the fetch and jetrules_utils.go's read of
#     <WORKSPACES_HOME>/<workspace>/build/classes.json finds nothing.
#
# So enabling it here needs the workspace to reach WORKSPACES_HOME first. Setting
# WORKSPACES_HOME=/workspaces is not the answer on its own: a Lambda filesystem
# is read-only outside /tmp, so the version-mismatch case - the one where the
# fetch is actually needed - would then fail on the write. The handler copying
# /workspaces to /tmp on cold start, as cbooter does for the task, is the shape
# that works. Until that exists, leave this as an ARG.
ARG JETS_VERSION
ARG JETS_GIT_SHA
RUN echo "----------------JetStore-Version------------------" >> /VERSION.txt && \
    echo "JETS_VERSION: ${JETS_VERSION}"                      >> /VERSION.txt && \
    echo "JETS_GIT_SHA: ${JETS_GIT_SHA}"                      >> /VERSION.txt && \
    echo "----------------*********************-------------" >> /VERSION.txt

# Copy the binary as 'bootstrap' to the Lambda task root
COPY --from=builder $JETS_SOURCE_DIR/bootstrap ${LAMBDA_RUNTIME_DIR}

# COPY native rule engine library
COPY --from=builder ${JETS_BUILD_DIR}/jets/libjets.so /usr/local/lib/
#* Verify lib version when upgrading dependencies
COPY --from=builder /usr/lib64/libboost_date_time.so.1.75.0 /usr/local/lib/
COPY --from=builder /lib64/libsqlite3.so.0.8.6 /usr/local/lib/
COPY --from=builder /lib64/libgflags.so.2.2 /usr/local/lib/
COPY --from=builder /usr/local/lib64/libglog.so.0.6.0 /usr/local/lib/

# Set library path environment variable instead of using ldconfig
ENV LD_LIBRARY_PATH=/usr/local/lib
# Create a simple library cache manually
RUN echo "/usr/local/lib" > /etc/ld.so.conf.d/local.conf

# Make sure bootstrap is executable
RUN chmod +x ${LAMBDA_RUNTIME_DIR}/bootstrap

RUN \
    cd /usr/local/lib/ \
    && chmod +x libglog.so.0.6.0 \
    && chmod +x libboost_date_time.so.1.75.0 \
    && chmod +x libsqlite3.so.0.8.6 \
    && chmod +x libgflags.so.2.2 \
    && ln -s libglog.so.0.6.0 libglog.so.1  \
    && echo "/usr/local/lib/ DIRECTORY Contains" \
    && ls -la /usr/local/lib/ \
    && echo "ldd libjets.so" \
    && ldd libjets.so \
    && echo "LAMBDA_RUNTIME_DIR DIRECTORY Contains" \
    && ls -la ${LAMBDA_RUNTIME_DIR} \
    && cd / 

# Set the entrypoint to use the Lambda runtime interface
CMD [ "bootstrap" ]
ENTRYPOINT ["/lambda-entrypoint.sh"]