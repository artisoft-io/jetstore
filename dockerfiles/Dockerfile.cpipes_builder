FROM cpipes_base_builder:latest

ARG JETS_VERSION
ENV JETS_VERSION=${JETS_VERSION}

# JetStore Build
# Set working directory
ENV JETS_SOURCE_DIR=/app JETS_BUILD_DIR=/app
RUN mkdir -p ${JETS_SOURCE_DIR}
RUN mkdir -p ${JETS_BUILD_DIR}

WORKDIR ${JETS_SOURCE_DIR}

# Copy source files
#
# **There is deliberately no `COPY .git` here, and this comment is what stops it
# coming back.** One was carried until 2026-09-13 and nothing in the image ever
# read it: this Dockerfile runs no git, `CMakeLists.txt` has no `git`,
# `FetchContent` or `GIT_REPOSITORY`, the built binaries carry no `vcs.*` stamps,
# and no runtime stage copies `.git` out of this one. The single
# `exec.Command("git", ...)` in the repository is `runGit`
# (`jets/datatable/git/workspace_git.go:79`), and every caller sets `cmd.Dir` to a
# `WORKSPACES_HOME/<workspace>` path -- never to JETS_SOURCE_DIR.
#
# **The fact the image actually needs is the commit, and it arrives as a build
# arg**: `JETS_GIT_SHA=${branch}-${sha}`, computed on the host in
# `build_cpipes.sh` and passed with `--build-arg`. Supplying the fact is what the
# copy was reaching for.
#
# **It failed differently in the two checkouts and neither was visible.** From a
# plain clone `.git` is a real tree that changes on every commit, so the COPY
# busted the cache here and forced `go mod tidy`, `go get all` and the whole C++
# build to re-run -- most of this image, on every commit. From a superproject
# checkout, where jetstore is a submodule, `.git` is a 36-byte pointer file, so
# the image got `gitdir: ../.git/modules/jetstore_ai` pointing at nothing and
# `git rev-parse` inside /app failed outright. Cheap and broken, or expensive and
# unused, depending on how the tree was obtained.
#
# `git` the binary is still required and still installed: `go mod download` uses
# it to fetch modules. What is not required is a `.git` directory of our own.
COPY CMakeLists.txt      ${JETS_SOURCE_DIR}/
COPY go.mod              ${JETS_SOURCE_DIR}/
COPY jets                ${JETS_SOURCE_DIR}/jets
COPY jetsclient_ide      ${JETS_SOURCE_DIR}/jetsclient_ide
COPY cdk/jetstore_one    ${JETS_SOURCE_DIR}/cdk/jetstore_one

# Set CGO environment variables
ENV CGO_ENABLED=1
ENV GOOS=linux
ENV GOARCH=amd64
RUN go mod tidy
RUN go get all
RUN go mod download

# Build the C++ library - native rule engine
WORKDIR ${JETS_BUILD_DIR}
ENV LD_LIBRARY_PATH=/usr/local/lib64

RUN cmake -DCMAKE_BUILD_TYPE=Release -DJETS_VERSION=$JETS_VERSION ${JETS_SOURCE_DIR}
RUN make clean 
RUN make objlib jets_static jets -j8

# RUN \
#   echo "$JETS_BUILD_DIR DIRECTORY Contains" \
#   && ls -la $JETS_BUILD_DIR \
#   && echo "$JETS_BUILD_DIR/jets DIRECTORY Contains" \
#   && ls -la $JETS_BUILD_DIR/jets \
#   && echo "/usr/lib64 DIRECTORY Contains" \
#   && ls -la /usr/lib64 \
#   && echo "/usr/local/lib64 DIRECTORY Contains" \
#   && ls -la /usr/local/lib64 \
#   && echo "/usr/local/lib DIRECTORY Contains" \
#   && ls -la /usr/local/lib 

RUN \
  cd $JETS_BUILD_DIR/jets \
  && ldconfig \
  && echo "ldd libjets.so:" \
  && ldd $JETS_BUILD_DIR/jets/libjets.so 

# Go back to source directory
WORKDIR ${JETS_SOURCE_DIR}

# Build the Go binaries with CGO enabled
RUN go build -ldflags="-w -s" -o cbooter              ${JETS_SOURCE_DIR}/jets/cmds/cbooter
# RUN go build -ldflags="-w -s" -o cpipes_server        ${JETS_SOURCE_DIR}/jets/cmds/cpipes_server
RUN go build -ldflags="-w -s" -o compile_workspace    ${JETS_SOURCE_DIR}/jets/cmds/compile_workspace
# Installs the JetStore-owned workspace assets (jets/workspace_assets) into the
# client workspace; runs in Dockerfile.compile_ws just before compile_workspace.
RUN go build -ldflags="-w -s" -o install_workspace_assets ${JETS_SOURCE_DIR}/jets/cmds/install_workspace_assets
RUN go build -ldflags="-w -s" -o bootstrap            ${JETS_SOURCE_DIR}/cdk/jetstore_one/lambdas/compute_pipes/cp_node_native
RUN go build -ldflags="-w -s" -o cpipes_native_server ${JETS_SOURCE_DIR}/jets/cmds/cpipes_native_server
RUN go build -ldflags="-w -s" -o apiserver            ${JETS_SOURCE_DIR}/jets/apiserver
RUN go build -ldflags="-w -s" -o run_reports          ${JETS_SOURCE_DIR}/jets/run_reports
RUN go build -ldflags="-w -s" -o update_db            ${JETS_SOURCE_DIR}/jets/update_db

# Copy workspace db schema for compile_workspace utility 
# Copy programs resources
RUN cp ${JETS_SOURCE_DIR}/jets/jets_schema.json       /usr/local/bin/jets_schema.json
RUN cp ${JETS_SOURCE_DIR}/jets/workspace_schema.sql   /usr/local/bin/workspace_schema.sql
RUN cp ${JETS_SOURCE_DIR}/jets/jets_init_db.sql       /usr/local/bin/jets_init_db.sql
