# The builder stage this image copies its binaries out of.
#
# **The default is the stock builder, and that default is exit criterion 98.** A
# build that passes no --build-arg resolves to `cpipes_builder:latest`, which is
# the literal this line carried before the ARG existed, so a deployment with no
# site operators builds from the same stage, with the same inputs, and the eight
# COPY --from=builder lines below are unchanged.
#
# A site that ships its own compute_pipes operators passes
# CPIPES_BUILDER_IMAGE=cpipes_builder_ws:latest -- Dockerfile.cpipes_builder_ws,
# which is `FROM cpipes_builder` plus one binary. Its cpipes_native_server is
# built from the site's own main package, and everything else copied below
# (cbooter, run_reports, libjets.so and the four system libraries) is the parent
# image's, byte for byte, because nothing in that Dockerfile rebuilds them.
#
# **The site binary keeps the stock name, and that is forced rather than
# chosen.** The ECS task's entry point is `cbooter cpipes_native_server`
# (`build_ecs_tasks.go:150`); cbooter refuses any command outside its allowlist
# (`allowedCommands`, `jets/cmds/cbooter/main.go:63`) and execs it by PATH
# lookup (`runCommandAsJsuser`). A site task binary under any other name would
# need a stack change and a cbooter change; one written over the stock path
# needs neither.
#
# An ARG before the first FROM is a global ARG -- in scope for FROM lines and
# out of scope inside every stage, which is why the stages below re-declare the
# ARGs they use.
ARG CPIPES_BUILDER_IMAGE=cpipes_builder:latest
FROM ${CPIPES_BUILDER_IMAGE} AS builder

# RUN \
#     echo "/usr/local/lib64/ DIRECTORY Contains" \
#     && ls -la /usr/local/lib64/

# Use the Amazon Linux 2023 base image
FROM public.ecr.aws/amazonlinux/amazonlinux:2023

# # Install runtime dependencies
RUN dnf update -y && \
  dnf install -y libstdc++ shadow-utils && \
  dnf clean all

# Create a system group and user
ARG USER_ID="999"
ARG GROUP_ID="999"
RUN groupadd -g ${GROUP_ID} jsuser \
    && useradd -l -r -u ${USER_ID} -g jsuser jsuser

ENV JETS_SOURCE_DIR=/app JETS_BUILD_DIR=/app

# JETS_VERSION is the build's timestamp, stamped identically into every image of
# a build run by build_cpipes.sh. It is not only provenance: compile_workspace
# writes it into the database as the workspace version (Dockerfile.compile_ws,
# which inherits it from cpipes_builder), and SyncComputePipesWorkspace skips
# fetching workspace.tgz and sqlite when the database's version matches this
# one - because an image carrying its own compiled workspace already has them.
#
# It was passed by build_cpipes.sh and discarded here until 2026-08-22: an ARG
# is scoped to its stage and ENV does not cross the FROM above, so this final
# stage inherited neither and every task cold-started with a download it did
# not need.
ARG JETS_VERSION
ENV JETS_VERSION=${JETS_VERSION}
ARG JETS_GIT_SHA
ENV JETS_GIT_SHA=${JETS_GIT_SHA}
RUN echo "----------------JetStore-Version------------------" >> /VERSION.txt && \
    echo "JETS_VERSION: ${JETS_VERSION}"                      >> /VERSION.txt && \
    echo "JETS_GIT_SHA: ${JETS_GIT_SHA}"                      >> /VERSION.txt && \
    echo "----------------*********************-------------" >> /VERSION.txt

# Copy the binaries to usr/local/bin for ecs tasks
COPY --from=builder $JETS_SOURCE_DIR/cbooter /usr/local/bin/
COPY --from=builder $JETS_SOURCE_DIR/run_reports /usr/local/bin/
COPY --from=builder $JETS_SOURCE_DIR/cpipes_native_server /usr/local/bin/

# COPY native rule engine library
COPY --from=builder ${JETS_BUILD_DIR}/jets/libjets.so /usr/local/lib/
#* Verify lib version when upgrading dependencies
COPY --from=builder /usr/lib64/libboost_date_time.so.1.75.0 /usr/local/lib/
COPY --from=builder /lib64/libsqlite3.so.0.8.6 /usr/local/lib/
COPY --from=builder /lib64/libgflags.so.2.2 /usr/local/lib/
COPY --from=builder /usr/local/lib64/libglog.so.0.6.0 /usr/local/lib/

# Set library path environment variable instead of using ldconfig
ENV LD_LIBRARY_PATH=/usr/local/lib
# Create a simple library cache manually
RUN echo "/usr/local/lib" > /etc/ld.so.conf.d/local.conf

# Make sure it is executable
RUN \
chmod +x /usr/local/bin/cpipes_native_server \
&& chmod +x /usr/local/bin/cbooter

RUN \
    cd /usr/local/lib/ \
    && chmod +x libglog.so.0.6.0 \
    && chmod +x libboost_date_time.so.1.75.0 \
    && chmod +x libsqlite3.so.0.8.6 \
    && chmod +x libgflags.so.2.2 \
    && ln -s libglog.so.0.6.0 libglog.so.1  \
    && echo "/usr/local/lib/ DIRECTORY Contains" \
    && ls -la /usr/local/lib/ \
    && echo "ldd libjets.so" \
    && ldd libjets.so \
    && cd / 
