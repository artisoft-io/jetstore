FROM public.ecr.aws/amazonlinux/amazonlinux:2023

RUN dnf update && dnf install -y \
  libstdc++ gcc gcc-c++ make cmake pkgconfig git \
  boost-devel sqlite-devel gflags-devel \
  wget tar ldconfig xz which

# RUN echo "Listing /usr/local/lib/" \
#   && ls -la /usr/local/lib/

# RUN echo "Listing /lib/" \
#   && ls -la /lib/

# RUN echo "Listing /lib64/" \
#   && ls -la /lib64/

# Install Go
RUN wget -q https://go.dev/dl/go1.26.5.linux-amd64.tar.gz \
    && tar -C /usr/local -xzf go1.26.5.linux-amd64.tar.gz \
    && rm go1.26.5.linux-amd64.tar.gz
ENV PATH=$PATH:/usr/local/go/bin
RUN go version

# Install flutter stable
RUN wget -q "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_3.44.5-stable.tar.xz"
RUN ls -la ./flutter_linux_3.44.5-stable.tar.xz
RUN tar  -C /usr/local -xf ./flutter_linux_3.44.5-stable.tar.xz
RUN rm flutter_linux_3.44.5-stable.tar.xz

RUN git config --global --add safe.directory /usr/local/flutter
ENV PATH="${PATH}:/usr/local/flutter/bin"
RUN flutter --version
RUN dart --version

# Install Node.js - builds the Workspace IDE (jetsclient_ide), a vite/react app
# served by the apiserver alongside the flutter bundle.
# Pinned to a release tarball rather than taken from dnf for the same reason Go
# and Flutter are: the distro package floats across rebuilds and the toolchain
# must not. Extracted under its own prefix like flutter, rather than splatted
# into /usr/local, so it can be removed or bumped without touching anything else.
RUN wget -q "https://nodejs.org/dist/v24.19.0/node-v24.19.0-linux-x64.tar.xz" \
    && mkdir -p /usr/local/node \
    && tar -C /usr/local/node --strip-components=1 -xf node-v24.19.0-linux-x64.tar.xz \
    && rm node-v24.19.0-linux-x64.tar.xz
ENV PATH="${PATH}:/usr/local/node/bin"
RUN node --version
RUN npm --version

# Abseil
RUN wget -q "https://github.com/abseil/abseil-cpp/releases/download/20260107.1/abseil-cpp-20260107.1.tar.gz"  \
    && tar xf "abseil-cpp-20260107.1.tar.gz"  \
    && cd "abseil-cpp-20260107.1"  \
    && mkdir build && cd build \
    && cmake -DCMAKE_CXX_FLAGS=-fPIC -DABSL_BUILD_TESTING=OFF -DCMAKE_CXX_STANDARD=20 .. \
    && make -j6  \
    && make install \
    && make clean 

# Google Log
RUN wget -q "https://github.com/google/glog/archive/refs/tags/v0.6.0.tar.gz"  \
    && tar xf "v0.6.0.tar.gz"  \
    && cd "glog-0.6.0/"  \
    && mkdir build && cd build \
    && cmake -DCMAKE_CXX_FLAGS=-fPIC -DCMAKE_CXX_STANDARD=20 .. \
    && make -j6  \
    && make install \
    && make clean 

RUN cd /usr/local/lib64/ \
    && ldconfig \
    && ls -la /usr/local/lib64/

