FROM cpipes_builder:latest AS builder

# RUN \
#     echo "/usr/local/lib64/ DIRECTORY Contains" \
#     && ls -la /usr/local/lib64/

# Use the Amazon Linux 2023 base image
FROM public.ecr.aws/amazonlinux/amazonlinux:2023

# # Install runtime dependencies
#
# libstdc++ is named for node (below), which links it. git happens to pull it in
# today -- measured in this image on 2026-10-01 -- but a dependency of a
# dependency is not something to rest the workspace compile on.
RUN dnf update -y && \
  dnf install -y git libstdc++ && \
  dnf clean all

RUN ln -s /usr/bin/git /usr/local/bin/git
ENV PATH=$PATH:/usr/local/bin

# Node, for the workspace document validator -- jetstore_maintenance_02 AG.6
# (R12, Q-9 answered `b`).
#
# The apiserver compiles the workspace at startup when its version is behind, and
# on the IDE's compile action; both now run `node jets_validate_workspace.mjs`
# first and **fail the compile rather than skip** when node is absent
# (jets/workspace/asset_validation.go). This image had no node until now (F45).
#
# The same build as the Docker build's compile uses, copied out of the builder
# rather than installed from dnf, so the two gates run one interpreter at one
# version (Dockerfile.cpipes_base_builder pins it). **The binary alone**, not the
# whole /usr/local/node: of its 205MB, 121MB is bin/node and the rest is C headers
# (65MB) and npm and corepack (19MB), measured in cpipes_builder on 2026-10-01, and
# nothing here compiles an addon or installs a package. run_reports, which this image also carries, opts out
# of the validation explicitly and needs none of it.
COPY --from=builder /usr/local/node/bin/node /usr/local/node/bin/node
ENV PATH=$PATH:/usr/local/node/bin
RUN node --version

ENV JETS_SOURCE_DIR=/app JETS_BUILD_DIR=/app

ARG JETS_VERSION
ENV JETS_VERSION=${JETS_VERSION}
ARG JETS_GIT_SHA
ENV JETS_GIT_SHA=${JETS_GIT_SHA}
RUN echo "----------------JetStore-Version------------------" >> /VERSION.txt && \
    echo "JETS_VERSION: ${JETS_VERSION}"                      >> /VERSION.txt && \
    echo "JETS_GIT_SHA: ${JETS_GIT_SHA}"                      >> /VERSION.txt && \
    echo "----------------*********************-------------" >> /VERSION.txt

# Copy the binaries to usr/local/bin for ecs tasks
#
# **No chmod after these**, for the reason given at the harness below: go build in
# Dockerfile.cpipes_builder writes all four 0755 and COPY keeps the mode. A
# `RUN chmod +x` of the four used to follow, and a chmod in a later layer stores
# every file it touches again -- measured on 2026-10-11, that layer was 140 MB of
# a 726 MB image, the four binaries' sizes summed, and changed no mode (all four
# were 755 before it and after it).
COPY --from=builder $JETS_SOURCE_DIR/cbooter /usr/local/bin/
COPY --from=builder $JETS_SOURCE_DIR/apiserver /usr/local/bin/
COPY --from=builder $JETS_SOURCE_DIR/update_db /usr/local/bin/
COPY --from=builder $JETS_SOURCE_DIR/run_reports /usr/local/bin/
# The agentic detection commands -- agentic_ai I-861. This image is the one the
# run_reports task and the scheduled detection task both run (JetStoreImage in
# cdk/jetstore_one), and it already carries the database secret's consumers. Each
# is asked for its usage, which exits 0 and proves the binary loads here.
COPY --from=builder $JETS_SOURCE_DIR/anomaly_detect /usr/local/bin/
COPY --from=builder $JETS_SOURCE_DIR/shadow_triage /usr/local/bin/
RUN anomaly_detect -h > /dev/null 2>&1 && shadow_triage -h > /dev/null 2>&1
# Beside the apiserver, which is where CompileWorkspace looks for it when
# JETS_WORKSPACE_VALIDATOR is unset. Built in Dockerfile.cpipes_builder.
COPY --from=builder $JETS_SOURCE_DIR/jets_validate_workspace.mjs /usr/local/bin/

# The rules unit test harness, and the C++ rule engine it links --
# rules_unit_test_harness AC.6.
#
# The apiserver runs one harness process per test, from a pool, and looks for it
# beside itself when JETS_RULES_UNIT_TEST_HARNESS is unset
# (jets/datatable/rules_unit_test_pool.go). A test runs on the C++ engine by
# default, the one the workspaces run in production, so the image carries
# libjets.so and the three libraries of the builder's own that it needs, copied
# as Dockerfile.cpipes copies them. The rest -- libstdc++, libsqlite3, libz,
# libgcc_s -- this image already has in /lib64; the ldd below is what says so,
# and fails the build when any library is missing, since ldd itself exits 0.
#
# LD_LIBRARY_PATH is set for the whole image rather than only for the child: the
# pool passes the apiserver's environment on (less its secrets), and
# /usr/local/lib holds nothing but these four, so the apiserver, git and node
# resolve nothing differently. Running the harness with no arguments loads every
# library and exits 2 on the usage error, which proves the dynamic link and not
# only the file list.
#
# **No chmod on the harness**: go build writes it 0755 and COPY keeps the mode,
# and a chmod in a later layer stores the whole file again -- measured on
# 2026-10-11, a RUN that only chmod'ed it added 49.3 MB, the binary's own size.
COPY --from=builder $JETS_SOURCE_DIR/rules_unit_test /usr/local/bin/
COPY --from=builder ${JETS_BUILD_DIR}/jets/libjets.so /usr/local/lib/
#* Verify lib version when upgrading dependencies
COPY --from=builder /usr/lib64/libboost_date_time.so.1.75.0 /usr/local/lib/
COPY --from=builder /lib64/libgflags.so.2.2 /usr/local/lib/
COPY --from=builder /usr/local/lib64/libglog.so.0.6.0 /usr/local/lib/
ENV LD_LIBRARY_PATH=/usr/local/lib
RUN \
    cd /usr/local/lib \
    && ln -s libglog.so.0.6.0 libglog.so.1 \
    && echo "ldd rules_unit_test" \
    && ldd /usr/local/bin/rules_unit_test \
    && ! ldd /usr/local/bin/rules_unit_test | grep -q 'not found' \
    && (rules_unit_test > /dev/null 2>&1; test $? -eq 2) \
    && cd /

# cbooter drops to jsuser (uid/gid 999) before exec'ing the apiserver, and switching uid
# does not change HOME. Left at the /root the container runtime supplies for uid 0, git
# looks for $HOME/.config/git/attributes and $HOME/.config/git/ignore under a directory
# uid 999 cannot read, so a git command run through the UI answers with permission warnings
# ahead of its output -- measured 2026-09-08 in this image: `git status` as uid 999 with
# HOME=/root prints the '/root/.config/git/ignore' warning and the same command with a
# writable HOME prints none. Which of the two paths a warning names depends on the
# operation, `attributes` being read by the ones that touch file content. Those warnings are
# the visible half; anything wanting a home it can write to -- `git config --global`, a
# credential helper's store -- fails without saying so. HOME therefore has to
# point somewhere jsuser owns, and JETS_TEMP_DATA is the mounted volume, the one place the
# read-only root filesystem leaves writable. Dockerfile.infer_service and
# Dockerfile.infer_service_vllm carry the same two lines for the same reason; this image
# was left out when they were written.
#
# JETS_TEMP_DATA is declared here rather than only in Dockerfile.ui_service_ws because
# ${...} in an ENV resolves against the build that contains it: a downstream ENV set in an
# image built FROM this one is not in scope while this line is read. Measured against this
# image on 2026-09-08 rather than reasoned from the manual -- `ENV HOME=${JETS_TEMP_DATA}/home`
# alone resolves to /home, and the same line preceded by the ENV below resolves to
# /jetsdata/home. Dockerfile.ui_service_ws restates the same /jetsdata, so today the two
# agree; a child image that changed it would leave HOME behind at the value baked here,
# which the same measurement confirmed.
#
# What that leaves open is a divergence, and it is not hypothetical: the task definition
# passes JETS_TEMP_DATA into the container (uiEnvironment, cdk/jetstore_one/stack/build_ui_service.go:49)
# from a synth-time variable, so a site that overrides it gets a runtime JETS_TEMP_DATA
# that no longer contains the HOME baked in here. cbooter checks for exactly that before it
# creates the directory (checkJsuserHome, jets/cmds/cbooter/main.go) and warns rather than
# starting a chown of the wrong tree.
ENV JETS_TEMP_DATA=/jetsdata
ENV HOME=${JETS_TEMP_DATA}/home
