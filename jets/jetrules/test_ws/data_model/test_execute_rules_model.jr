# Data Model for the characterisation test of JrPoolWorker.executeRules
# (jets/compute_pipes/jetrules_execute_rules_test.go)

class xr:Case {
  $base_classes = [jets:Entity],
  $data_properties = [
    xr:mode     as text,
    xr:result   as text,
    xr:count    as int,
    xr:amount   as int,
    xr:group    as text
  ],
  $as_table = true
};
