# =======================================================================================
# jetstore-owned-asset: data_model/jets_agentic.jr — DO NOT EDIT.
# Source: `jets-agentic generate`, from tools/jets_agentic/jets_agentic/model.py (model
# version 0.1.0).
# Installed into this workspace at image build time and overwritten on every build; a
# local edit is lost, and the build fails rather than clobbering it silently. Extend the
# model from your own file that imports this one.
#   import "data_model/jets_agentic.jr"
# =======================================================================================
# The schema-first authoring surface of decision 7: new agentic entities are
# authored in the Python source; existing data models and all rules stay in .jr.

import "data_model/jets_model.jr"

# One execution of one agent: the unit the audit store correlates on
class jetsa:AgentRun {
  $base_classes = [jets:Entity],
  $data_properties = [
    jetsa:run_id as text,
    jetsa:agent_id as text,
    jetsa:agent_version as text,
    jetsa:model_id as text,
    jetsa:prompt_version as text,
    jetsa:tier as text,
    jetsa:started_at as datetime,
    jetsa:ended_at as datetime,
    jetsa:run_status as text,
    jetsa:triggered_by as text,
    jetsa:domain_model_version as text,
    jetsa:iteration_cap as int,
    jetsa:wall_clock_cap_seconds as int,
    jetsa:token_spend as int
  ],
  $as_table = true
};

# One human or agent decision on a supervised subject: the supervision
class jetsa:ApprovalEvent {
  $base_classes = [jets:Entity],
  $data_properties = [
    jetsa:approval_event_id as text,
    jetsa:run_ref as text,
    jetsa:subject_ref as text,
    jetsa:from_state as text,
    jetsa:to_state as text,
    jetsa:actor as text,
    jetsa:tier_at_event as text,
    jetsa:decided_at as datetime,
    jetsa:decision_rationale as text
  ],
  $as_table = true
};

# A proposed code or configuration change (§A.2.10), flattened to scalar
class jetsa:ChangeProposal {
  $base_classes = [jets:Entity],
  $data_properties = [
    jetsa:proposal_id as text,
    jetsa:trigger as text,
    jetsa:trigger_ref as text,
    jetsa:affected_pipelines as array of text,
    jetsa:code_diff_repository as text,
    jetsa:code_diff_branch as text,
    jetsa:code_diff_files_changed as array of text,
    jetsa:code_diff_lines_added as int,
    jetsa:code_diff_lines_removed as int,
    jetsa:rationale as text,
    jetsa:assumptions_made as array of text,
    jetsa:generated_tests as array of text,
    jetsa:ci_result_status as text,
    jetsa:ci_result_tests_run as int,
    jetsa:ci_result_tests_failed as int,
    jetsa:impact_affected_assets as array of text,
    jetsa:impact_clinical_relevance_touched as bool,
    jetsa:approval_state as text,
    jetsa:proposal_model_version as text
  ],
  $as_table = true
};

# A deterministic detector's observation (§A.2.6), widened at N.2 from the
class jetsa:Anomaly {
  $base_classes = [jets:Entity],
  $data_properties = [
    jetsa:anomaly_id as text,
    jetsa:detected_at as datetime,
    jetsa:anomaly_session_id as text,
    jetsa:anomaly_subject_type as text,
    jetsa:anomaly_subject_ref as text,
    jetsa:anomaly_signal_type as text,
    jetsa:anomaly_observed_value as text,
    jetsa:anomaly_expected_min as text,
    jetsa:anomaly_expected_max as text,
    jetsa:anomaly_expected_basis as text,
    jetsa:anomaly_deviation_magnitude as double,
    jetsa:anomaly_confounders as array of text,
    jetsa:anomaly_detector_ref as text
  ],
  $as_table = true
};

# One evidence item of a Hypothesis (§A.2.8 `$defs`): a value object in
class jetsa:Evidence {
  $base_classes = [owl:Thing],
  $data_properties = [
    jetsa:statement as text,
    jetsa:source as text,
    jetsa:source_ref as text
  ],
  $as_table = false
};

# A causal hypothesis for an Incident (§A.2.8): the RCA agent's output
class jetsa:Hypothesis {
  $base_classes = [jets:Entity],
  $data_properties = [
    jetsa:hypothesis_id as text,
    jetsa:hypothesis_incident_ref as text,
    jetsa:cause as text,
    jetsa:cause_category as text,
    jetsa:confidence as double,
    jetsa:rank as int
  ],
  $object_properties = [
    jetsa:supporting_evidence as array of resource,
    jetsa:contradicting_evidence as array of resource
  ],
  $as_table = true
};

# A triaged cluster of anomalies (§A.2.7), keyed on a session (AB.1).
class jetsa:Incident {
  $base_classes = [jets:Entity],
  $data_properties = [
    jetsa:incident_id as text,
    jetsa:incident_session_id as text,
    jetsa:incident_detected_at as datetime,
    jetsa:incident_locus as text,
    jetsa:classification as text,
    jetsa:severity as text,
    jetsa:status as text,
    jetsa:incident_step_ref as text,
    jetsa:incident_shard_ref as int,
    jetsa:incident_confounders as array of text,
    jetsa:incident_model_version as text
  ],
  $object_properties = [
    jetsa:hypotheses as array of resource
  ],
  $as_table = true
};

# A proposed corrective action (§A.2.9), tabled at AB.2 and with no executor.
class jetsa:Remediation {
  $base_classes = [jets:Entity],
  $data_properties = [
    jetsa:remediation_id as text,
    jetsa:incident_ref as text,
    jetsa:autonomy_tier_required as text,
    jetsa:reversibility as text,
    jetsa:remediation_approval_state as text
  ],
  $as_table = true
};

# A released version of the domain model itself (proposal §5.3: identity
class jetsa:DomainModelVersion {
  $base_classes = [jets:Entity],
  $data_properties = [
    jetsa:version as text,
    jetsa:effective_at as datetime
  ],
  $as_table = false
};

# One transition of one Incident: who moved it, when, and from what to what.
class jetsa:IncidentEvent {
  $base_classes = [jets:Entity],
  $data_properties = [
    jetsa:incident_event_id as text,
    jetsa:event_incident_ref as text,
    jetsa:from_status as text,
    jetsa:to_status as text,
    jetsa:event_actor as text,
    jetsa:event_actor_kind as text,
    jetsa:transitioned_at as datetime,
    jetsa:event_run_ref as text,
    jetsa:classification_before as text,
    jetsa:classification_after as text,
    jetsa:transition_rationale as text
  ],
  $as_table = true
};

