{
  "schemaVersion": 1,
  "title": "Pipeline Configuration",
  "startAtKey": "select_pipeline_config",
  "states": {
    "select_pipeline_config": {
      "description": "Select a Pipeline Config to edit, or add one",
      "formConfig": "pcSelectPipelineConfigUF",
      "stateAction": "pcSelectPipelineConfigUF",
      "goToStates": [
        "add_pipeline_config"
      ],
      "defaultNextState": "select_main_process_input"
    },
    "add_pipeline_config": {
      "description": "Add Pipeline Config",
      "formConfig": "pcAddPipelineConfigUF",
      "stateAction": "pcAddPipelineConfigUF",
      "goToStates": [
        "select_pipeline_config"
      ],
      "defaultNextState": "select_main_process_input"
    },
    "select_main_process_input": {
      "description": "Select the main process input",
      "formConfig": "pcSelectMainProcessInputUF",
      "stateAction": "pcSelectMainProcessInputUF",
      "goToStates": [
        "select_pipeline_config"
      ],
      "defaultNextState": "view_merge_process_inputs"
    },
    "view_merge_process_inputs": {
      "description": "View the merge process inputs",
      "formConfig": "pcViewMergeProcessInputsUF",
      "goToStates": [
        "add_merge_process_inputs",
        "select_pipeline_config"
      ],
      "defaultNextState": "view_injected_process_inputs"
    },
    "view_injected_process_inputs": {
      "description": "View the merge process inputs",
      "formConfig": "pcViewInjectedProcessInputsUF",
      "goToStates": [
        "add_injected_process_inputs",
        "select_pipeline_config"
      ],
      "defaultNextState": "set_pipeline_automation"
    },
    "set_pipeline_automation": {
      "description": "Set pipeline automation",
      "formConfig": "pcAutomationUF",
      "stateAction": "pcPrepareSummaryUF",
      "goToStates": [
        "select_pipeline_config"
      ],
      "defaultNextState": "summaryUF"
    },
    "summaryUF": {
      "description": "Pipeline Configuration Summary",
      "formConfig": "pcSummaryUF",
      "stateAction": "pcSavePipelineConfigUF",
      "goToStates": [
        "select_pipeline_config"
      ],
      "defaultNextState": "select_pipeline_config"
    },
    "add_merge_process_inputs": {
      "description": "Add a merge process inputs",
      "formConfig": "pcAddMergeProcessInputsUF",
      "stateAction": "pcAddMergeProcessInputUF",
      "goToStates": [
        "select_pipeline_config"
      ],
      "defaultNextState": "view_merge_process_inputs"
    },
    "add_injected_process_inputs": {
      "description": "Add an injected process inputs",
      "formConfig": "pcAddInjectedProcessInputsUF",
      "stateAction": "pcAddInjectedProcessInputUF",
      "goToStates": [
        "select_pipeline_config"
      ],
      "defaultNextState": "view_injected_process_inputs"
    }
  }
}
