{
  "schemaVersion": 1,
  "title": "Source Configuration",
  "startAtKey": "select_source_config",
  "states": {
    "select_source_config": {
      "description": "Select a source configuration to edit, or add one",
      "formConfig": "scSelectSourceConfigUF",
      "stateAction": "scSelectSourceConfigUF",
      "goToStates": [
        "add_source_config"
      ],
      "defaultNextState": "select_file_type_option"
    },
    "add_source_config": {
      "description": "Add a source configuration",
      "formConfig": "scAddSourceConfigUF",
      "stateAction": "scAddSourceConfigUF",
      "goToStates": [
        "select_source_config"
      ],
      "defaultNextState": "select_file_type_option"
    },
    "select_file_type_option": {
      "description": "Select the file format: csv, parquet, fixed-width and others",
      "formConfig": "scSourceConfigTypeUF",
      "goToStates": [
        "select_source_config"
      ],
      "choices": [
        {
          "when": {
            "op": "equals",
            "key": "input_format",
            "value": "csv"
          },
          "nextState": "select_single_or_multi_part_file"
        },
        {
          "when": {
            "op": "equals",
            "key": "input_format",
            "value": "headerless_csv"
          },
          "nextState": "edit_csv_headers"
        },
        {
          "when": {
            "op": "equals",
            "key": "input_format",
            "value": "headerless_csv_with_schema_provider"
          },
          "nextState": "select_single_or_multi_part_file"
        },
        {
          "when": {
            "op": "equals",
            "key": "input_format",
            "value": "xlsx"
          },
          "nextState": "edit_xlsx_options"
        },
        {
          "when": {
            "op": "equals",
            "key": "input_format",
            "value": "headerless_xlsx"
          },
          "nextState": "edit_xlsx_options"
        },
        {
          "when": {
            "op": "equals",
            "key": "input_format",
            "value": "fixed_width"
          },
          "nextState": "edit_fixed_width_layout"
        },
        {
          "when": {
            "op": "equals",
            "key": "input_format",
            "value": "fixed_width_with_schema_provider"
          },
          "nextState": "select_single_or_multi_part_file"
        },
        {
          "when": {
            "op": "equals",
            "key": "input_format",
            "value": "parquet"
          },
          "nextState": "select_single_or_multi_part_file"
        },
        {
          "when": {
            "op": "equals",
            "key": "input_format",
            "value": "parquet_select"
          },
          "nextState": "edit_csv_headers"
        }
      ]
    },
    "edit_xlsx_options": {
      "description": "Specify additional options for xlsx files",
      "formConfig": "scEditXlsxOptionsUF",
      "stateAction": "scEditXlsxOptionsUF",
      "goToStates": [
        "select_source_config"
      ],
      "choices": [
        {
          "when": {
            "op": "equals",
            "key": "input_format",
            "value": "headerless_xlsx"
          },
          "nextState": "edit_csv_headers"
        }
      ],
      "defaultNextState": "select_single_or_multi_part_file"
    },
    "edit_csv_headers": {
      "description": "Give the column names of a file without a header, or the columns to read from a parquet file",
      "formConfig": "scEditFileHeadersUF",
      "goToStates": [
        "select_source_config"
      ],
      "defaultNextState": "select_single_or_multi_part_file"
    },
    "edit_fixed_width_layout": {
      "description": "Edit the fixed-width layout",
      "formConfig": "scEditFixedWidthLayoutUF",
      "goToStates": [
        "select_source_config"
      ],
      "defaultNextState": "select_single_or_multi_part_file"
    },
    "select_single_or_multi_part_file": {
      "description": "Select a single file or multi-part files",
      "formConfig": "scSelectSingleOrMultiPartFileUF",
      "goToStates": [
        "select_source_config"
      ],
      "defaultNextState": "edit_domain_keys"
    },
    "edit_domain_keys": {
      "description": "Edit the domain keys",
      "formConfig": "scEditDomainKeysUF",
      "goToStates": [
        "select_source_config"
      ],
      "defaultNextState": "edit_code_value_mapping"
    },
    "edit_code_value_mapping": {
      "description": "Edit the code value mapping",
      "formConfig": "scEditCodeValueMappingUF",
      "goToStates": [
        "select_source_config"
      ],
      "defaultNextState": "add_schema_provider_json"
    },
    "add_schema_provider_json": {
      "description": "Add the schema provider, as JSON",
      "formConfig": "scAddSchemaProviderJsonUF",
      "goToStates": [
        "select_source_config"
      ],
      "defaultNextState": "confirm_state"
    },
    "confirm_state": {
      "description": "Review and save the source configuration",
      "formConfig": "scSummaryUF",
      "stateAction": "addSourceConfig.ok",
      "goToStates": [
        "select_source_config"
      ],
      "defaultNextState": "select_source_config"
    }
  }
}
