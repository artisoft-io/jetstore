{
  "schemaVersion": 1,
  "title": "Load Client Configurations",
  "startAtKey": "load_config",
  "states": {
    "load_config": {
      "description": "Select the clients whose configuration to load",
      "formConfig": "wpLoadConfigUF",
      "stateAction": "wpLoadConfigConfirmUF",
