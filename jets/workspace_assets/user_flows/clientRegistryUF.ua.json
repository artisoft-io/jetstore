{
  "schemaVersion": 1,
  "actions": {
    "crAddClientUF": {
      "description": "Create a client",
      "steps": [
        { "do": "validate" },
        { "do": "set", "key": "details", "value": { "fromKey": "ufClientDetails" } },
        { "do": "post", "endpoint": "/dataTable", "action": "insert_rows", "table": "client_registry",
          "data": { "rows": "wholeState" } },
        { "do": "remove", "keys": ["details", "ufClientDetails"] }
      ]
    },
    "crSelectClientUF": {
      "description": "Select an existing client",
      "steps": [
        { "do": "validate" },
        { "do": "set", "key": "client", "value": { "fromKey": "client" } }
      ]
    },
    "deleteClientAction": {
      "description": "Delete the selected client",
      "steps": [
        { "do": "confirm", "message": "Are you sure you want to delete the selected client?" },
        { "do": "set", "key": "client", "value": { "fromKey": "client" } },
        { "do": "post", "endpoint": "/dataTable", "action": "insert_rows", "table": "delete/client",
          "data": { "rows": "wholeState" } },
        { "do": "clearSelection", "key": "client" },
        { "do": "remove", "keys": ["client", "details", "ufVendorDetails", "ufClientDetails", "org"] }
      ]
    },
    "deleteOrgAction": {
      "description": "Delete the selected organization",
      "steps": [
        { "do": "confirm", "message": "Are you sure you want to delete the selected organization?" },
        { "do": "set", "key": "client", "value": { "fromKey": "client" } },
        { "do": "set", "key": "org", "value": { "fromKey": "org" } },
        { "do": "post", "endpoint": "/dataTable", "action": "insert_rows", "table": "delete/org",
          "data": { "rows": "wholeState" } },
        { "do": "clearSelection", "key": "org" },
        { "do": "remove", "keys": ["details", "ufVendorDetails", "org"] }
      ]
    },
    "crAddVendorOk": {
      "description": "Create an organization for the client",
      "steps": [
        { "do": "validate" },
        { "do": "set", "key": "details", "value": { "fromKey": "ufVendorDetails" } },
        { "do": "post", "endpoint": "/dataTable", "action": "insert_rows", "table": "client_org_registry",
          "transport": "insertRows",
          "data": { "rows": "wholeState" } },
        { "do": "remove", "keys": ["details"] }
      ]
    },
    "dialogCancel": {
      "description": "Dismiss the dialog",
      "steps": [{ "do": "close" }]
    }
  }
}
