  "isCheckboxVisible": true,
  "isCheckboxSingleSelect": true,
  "formStateBinding": {
    "keyColumnIdx": 0,
    "otherColumns": [
      {
        "stateKey": "client",
        "columnIdx": 1
      },
      {
        "stateKey": "org",
        "columnIdx": 2
      },
      {
        "stateKey": "object_type",
        "columnIdx": 3
      },
      {
        "stateKey": "table_name",
        "columnIdx": 4
      }
    ]
