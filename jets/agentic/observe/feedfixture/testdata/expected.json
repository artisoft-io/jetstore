{
  "clock": "2026-06-01T05:00:00Z",
  "rules": {
    "joins": "A delivery is an input_registry row, joined to its feed on table_name with client and org, never on object_type: every delivery here is registered under the object type Member. Its period is input_registry.source_period_key joined to source_period, its arrival is its session id read as milliseconds, and its size is file_key_staging.file_size joined on file_key. file_key_staging.last_update is a sync time, not an arrival. A delivery's predecessor is the feed's previous delivery in registration order. Every delivery-grain verdict is a backfill verdict: each delivery is judged against what was registered before it and nothing after.",
    "feed_overdue": "At the clock. P is the latest period the feed has delivered, the maximum over its deliveries at the profile's period_type, not the period of the last registration. The next delivery is due in period P + periods_per_delivery, and the feed is overdue from the end of that period plus overdue_after_days. A week period runs Thursday to Wednesday (week_period counts weeks from the epoch, a Thursday), a month period is a calendar month. The finding hangs on the session of the feed's last registered delivery (on_delivery); first_fires_at is the first instant it holds.",
    "delivery_size": "file_size outside the declared size_bytes range, bounds inclusive. Every profiled feed here declares a range, so no verdict depends on a trailing band.",
    "delivery_backdated": "The delivery's period, at the profile's period_type, precedes the latest period of any delivery registered before it. The first delivery of a feed is not judged.",
    "service_date_stale": "The delivery's arrival date (UTC) less its newest service date, in days, exceeds max_service_date_lag_days. The arrival, not the period: a back-dated delivery is stale by this rule as well as back-dated.",
    "service_date_span": "Incremental feeds only: the newest less the oldest service date of one delivery, in days, exceeds max_service_date_span_days.",
    "field_completeness": "For each required field, the share of the delivery's rows (not keys) carrying a value is below min_present_share.",
    "delivery_overlap": "Over distinct values of the declared key columns, never rows. Incremental: the share of this delivery's distinct keys present in its predecessor exceeds max_redelivered_share. Cumulative: some key of the predecessor is absent from this delivery. The first delivery is not judged.",
    "delivery_unchanged": "Over distinct values of the declared key columns: the key set equals the predecessor's and the newest service date is not later than the predecessor's. The first delivery is not judged."
  },
  "not_judged_reasons": {
    "no_profile": "the feed has no profile",
    "field_absent:<field>": "the profile does not declare a field the detector needs",
    "cumulative_feed": "the detector judges incremental feeds only",
    "no_claim_rows": "the claim-set table holds no row of the delivery's session, as when the pipeline skips the database load; not evaluable rather than clean",
    "no_predecessor": "the detector compares a delivery with its predecessor, and the first delivery has none"
  },
